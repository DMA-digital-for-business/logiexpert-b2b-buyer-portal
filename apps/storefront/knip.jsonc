{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts", "src/headless.ts"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
  "rules": {
    "binaries": "off",
    "classMembers": "off",
    "enumMembers": "off",

    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "duplicates": "error",
    "exports": "error",
    "files": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error"
  },
  "babel": true,
  "ignoreDependencies": [
    "@bigcommerce/eslint-plugin", // Loaded by the legacy presets through FlatCompat
    "eslint-config-airbnb", // Loaded by name through FlatCompat
    "eslint-config-airbnb-typescript", // Loaded by name through FlatCompat
    "eslint-config-prettier", // Loaded by name through FlatCompat
    "eslint-plugin-import", // Loaded by the legacy presets through FlatCompat
    "eslint-plugin-jsx-a11y", // Loaded by the legacy presets through FlatCompat
    "eslint-plugin-prettier", // Loaded by the legacy presets through FlatCompat
    "eslint-plugin-react", // Loaded by the legacy presets through FlatCompat
    "eslint-plugin-react-hooks", // Loaded by the legacy presets through FlatCompat
    "eslint-plugin-simple-import-sort", // Loaded by name through FlatCompat
    "eslint-plugin-testing-library", // Loaded by the legacy presets through FlatCompat
    "graphql", // used to generate graphql types
    "@mui/styles", // used by react-mui-dropzone
    "@testing-library/dom", // used by @testing-library/react
    "terser" // Since Vite v3, terser has become an optional dependency. You need to install it.
  ],
  "prettier": true,
  "ignore": [
    "src/types/gql/graphql.ts",
    "src/shared/service/bc/graphql/base.ts",
    "src/shared/service/bc/graphql/orders.ts",
    "src/shared/service/bc/graphql/accountSetting.ts"
  ]
}
